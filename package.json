{
    "name": "assignment-user-matcher",
    "version": "1.16.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/ViljarVoidula/assignment-user-matcher"
    },
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.js"
        },
        "./scheduling": {
            "types": "./dist/scheduling/index.d.ts",
            "require": "./dist/scheduling/index.js",
            "import": "./dist/scheduling/index.js"
        }
    },
    "typesVersions": {
        "*": {
            "scheduling": [
                "dist/scheduling/index.d.ts"
            ]
        }
    },
    "author": "Viljar Võidula",
    "license": "MIT",
    "private": false,
    "dependencies": {
        "redis": "5.10.0"
    },
    "scripts": {
        "test": "nyc mocha tests/ --recursive --extension .ts --exit",
        "benchmark:learning": "ts-node benchmark-learning.ts",
        "benchmark:weights": "ts-node benchmark-weights.ts",
        "benchmark:scenarios": "ts-node benchmark-learning-scenarios.ts",
        "benchmark:scheduling": "ts-node benchmark-scheduling.ts",
        "build:docs": "npx typedoc --plugin typedoc-plugin-markdown",
        "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
        "lint:ci": "eslint . --quiet --cache --cache-location node_modules/.cache/eslint/.eslintcache",
        "lint:fix": "eslint . --fix",
        "check": "pnpm run lint:ci",
        "prettier": "prettier --write .",
        "build": "rimraf dist && tsc && mkdir -p dist/lua && cp src/lua/*.lua dist/lua/",
        "prepublishOnly": "pnpm run build",
        "release:patch": "bash ./scripts/release-patch-local.sh.example"
    },
    "prettier": {
        "semi": true,
        "singleQuote": true,
        "trailingComma": "all",
        "printWidth": 124,
        "tabWidth": 4
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/chai": "4.3.20",
        "@types/mocha": "10.0.10",
        "@types/node": "18.19.103",
        "@types/sinon": "10.0.20",
        "chai": "4.5.0",
        "eslint": "^9.39.5",
        "eslint-plugin-import-x": "^4.17.1",
        "globals": "^17.12.0",
        "mocha": "10.8.2",
        "nyc": "15.1.0",
        "prettier": "3.5.3",
        "rimraf": "4.4.1",
        "sinon": "20.0.0",
        "ts-node": "10.9.2",
        "typedoc": "^0.25.0",
        "typedoc-plugin-markdown": "3.17.1",
        "typescript": "4.9.5",
        "typescript-eslint": "^8.69.0"
    },
    "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
